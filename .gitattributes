*.sh text eol=lf
*.command text eol=lf
*.bin binary
*.onnx binary
*.dylib binary
*.png binary
*.pdf binary
# Preserve reviewed model bytes, including CRLF line endings.
/data/models/local_repair/*.json -text whitespace=cr-at-eol
# Preserve the original Wubi license, including its final empty line.
/third_party/wubi_haifeng/LICENSE -text whitespace=-blank-at-eof
